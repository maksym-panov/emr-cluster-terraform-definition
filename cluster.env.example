# =============================================================================
# EMR Cluster Power Configuration
# =============================================================================
# Copy this file to cluster.env and uncomment exactly ONE preset block.
# Then run:  terraform apply
# to resize the cluster before submitting a job.
#
# Pricing is per hour (eu-central-1, On-Demand) and covers the entire cluster:
#   1 master (m5.xlarge, fixed) + CLUSTER_CORE_COUNT core + CLUSTER_TASK_COUNT task
#   Master always costs ~$0.28/hr on top of the worker cost shown below.
#
# Use different presets across runs to observe how cluster "power" affects
# WordCount elapsed time, CPU utilisation, and memory pressure.
# =============================================================================


# -----------------------------------------------------------------------------
# PRESET: SMALL   ~$1.11/hr total
# Workers: m5.xlarge  |  4 vCPU  |  16 GB RAM  |  $0.278/node/hr
# Good for: tiny files (< 500 MB), baseline measurement
# -----------------------------------------------------------------------------
# CLUSTER_INSTANCE_TYPE=m5.xlarge
# CLUSTER_CORE_COUNT=2
# CLUSTER_TASK_COUNT=1


# -----------------------------------------------------------------------------
# PRESET: MEDIUM   ~$1.38/hr total
# Workers: r5.xlarge  |  4 vCPU  |  32 GB RAM  |  $0.367/node/hr
# Good for: 1 GB files, memory-sensitive workloads
# -----------------------------------------------------------------------------
# CLUSTER_INSTANCE_TYPE=r5.xlarge
# CLUSTER_CORE_COUNT=2
# CLUSTER_TASK_COUNT=1


# -----------------------------------------------------------------------------
# PRESET: LARGE   ~$2.48/hr total   ← default
# Workers: r5.2xlarge  |  8 vCPU  |  64 GB RAM  |  $0.734/node/hr
# Good for: 2–5 GB files, general-purpose benchmark
# -----------------------------------------------------------------------------
CLUSTER_INSTANCE_TYPE=r5.2xlarge
CLUSTER_CORE_COUNT=2
CLUSTER_TASK_COUNT=1


# -----------------------------------------------------------------------------
# PRESET: XLARGE   ~$4.68/hr total
# Workers: r5.4xlarge  |  16 vCPU  |  128 GB RAM  |  $1.468/node/hr
# Good for: 5–10 GB files, high-parallelism benchmark
# -----------------------------------------------------------------------------
# CLUSTER_INSTANCE_TYPE=r5.4xlarge
# CLUSTER_CORE_COUNT=2
# CLUSTER_TASK_COUNT=1


# -----------------------------------------------------------------------------
# PRESET: XXLARGE   ~$9.09/hr total
# Workers: r5.8xlarge  |  32 vCPU  |  256 GB RAM  |  $2.936/node/hr
# Good for: 10 GB+ files, maximum throughput benchmark
# CAUTION: verify your EC2 vCPU On-Demand quota before using this preset
# -----------------------------------------------------------------------------
# CLUSTER_INSTANCE_TYPE=r5.8xlarge
# CLUSTER_CORE_COUNT=2
# CLUSTER_TASK_COUNT=1
